# Copy to .env and edit. All values are optional except where noted.
# ---------------------------------------------------------------------------

# Host port to publish the UI/API on (container always listens on 8080).
VXV_BIND=8080

# --- Auth (primary) ---
# API key clients send as `X-API-Key`. If left blank, a key is generated on
# first boot and written to the data volume at /data/apikey.txt.
# The value below is a DEMO key so the app is usable the moment it boots.
# CHANGE IT before any real deployment.
VXV_API_KEY=vxv_demo_key_1234567890

# Signing secret for local-user session tokens. Leave blank to auto-generate.
VXV_SECRET_KEY=

# --- Auth (secondary: local users) ---
VXV_LOCAL_USERS=true
# A built-in default admin (admin / admin) is created on first boot so you can
# sign in with a username/password out of the box. It is hardcoded and always
# created. CHANGE IT before any real deployment (create your own admin below and
# stop using the default, or change the hardcoded value in app/main.py).
# Optional: also create an ADDITIONAL named admin on first boot.
# VXV_ADMIN_USER=ddias
# VXV_ADMIN_PASS=change-me-now

# --- Executor ---
# simulated | ssh | rest . Default 'simulated' runs with zero external
# dependencies and never touches a real device.
VXV_EXECUTOR=simulated

# Load the demo fabric (example VTEPs/VNIs/tunnels) on first boot. Handy for
# simulated mode; set false to start with an empty inventory and populate only
# from real discovery. You can also clear it any time from the Topology page.
VXV_SEED_DEMO=true

# --- Live device access (only used when executor is ssh/rest) ---
# Path (inside the container) to the CA bundle used to verify switch REST TLS.
VXV_CA_BUNDLE=/certs/ca-bundle.pem
VXV_SSH_TIMEOUT=20
VXV_REST_TIMEOUT=20
VXV_MAX_SESSIONS=2

# --- Storage ---
VXV_DATA_DIR=/data
