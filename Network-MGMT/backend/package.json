{
  "name": "network-mgmt-backend",
  "version": "1.0.0",
  "description": "Backend API for network management platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "mocha test/**/*.test.js --timeout 10000 --exit",
    "test:watch": "mocha test/**/*.test.js --watch --timeout 10000",
    "test:coverage": "nyc mocha test/**/*.test.js --timeout 10000 --exit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "network",
    "management",
    "monitoring",
    "discovery",
    "ssh",
    "snmp"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "sequelize": "^6.32.1",
    "pg": "^8.11.1",
    "pg-hstore": "^2.3.4",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.1",
    "dotenv": "^16.3.1",
    "ssh2": "^1.14.0",
    "telnet-client": "^2.0.6",
    "ping": "^0.4.4",
    "redis": "^4.6.7",
    "ip": "^2.0.0",
    "ipaddr.js": "^2.1.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "pino": "^8.17.2",
    "pino-http": "^9.0.0",
    "net-snmp": "^3.11.2",
    "nodemailer": "^6.9.8",
    "swagger-ui-express": "^5.0.0",
    "umzug": "^3.5.0",
    "socket.io": "^4.7.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "mocha": "^10.2.0",
    "chai": "^4.3.7",
    "chai-as-promised": "^7.1.1",
    "supertest": "^6.3.3",
    "nyc": "^15.1.0",
    "eslint": "^8.45.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.28.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "mocha": {
    "require": [
      "chai",
      "chai-as-promised"
    ],
    "timeout": 10000,
    "exit": true
  },
  "nyc": {
    "exclude": [
      "test/**",
      "node_modules"
    ],
    "reporter": [
      "text",
      "lcov",
      "html"
    ]
  }
}